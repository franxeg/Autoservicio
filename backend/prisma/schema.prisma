generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Rol {
  ADMIN
  CAJERO
  SETUP
}

enum EstadoVenta {
  PENDIENTE
  COMPLETADA
  CANCELADA
}

enum TipoMovimientoCaja {
  APERTURA
  VENTA
  COMPRA
  GASTO
  RETIRO
  CIERRE
  PAGO_CUENTA
}

enum TipoMovimientoStock {
  ENTRADA
  SALIDA
  AJUSTE
  MERMA
  PRODUCCION
}

enum UnidadVenta {
  UNIDAD
  KG
}

model Empresa {
  id        String   @id @default(cuid())
  nombre    String
  cuit      String?  @unique
  activa    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sucursales     Sucursal[]
  usuarios       Usuario[]
  categorias     Categoria[]
  productos      Producto[]
  stocks         Stock[]
  proveedores    Proveedor[]
  clientes       Cliente[]
  ventas         Venta[]
  compras        Compra[]
  cajas          Caja[]
  pagosClientes  PagoCliente[]
  detallesVenta  DetalleVenta[]
  detallesCompra DetalleCompra[]
  movimientosCaja MovimientoCaja[]
  movimientosStock MovimientoStock[]
  recetas        RecetaItem[]
}

model Sucursal {
  id        String   @id @default(cuid())
  nombre    String
  direccion String?
  telefono  String?
  activa    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id])

  usuarios  Usuario[]
  productos Stock[]
  ventas    Venta[]
  compras   Compra[]
  cajas     Caja[]
  clientes  Cliente[]
  pagos     PagoCliente[]
  movimientosStock MovimientoStock[]

  @@index([empresaId])
}

model Usuario {
  id         String   @id @default(cuid())
  username   String?  @unique
  email      String?  @unique
  password   String
  nombre     String
  rol        Rol      @default(CAJERO)
  activo     Boolean  @default(true)
  sucursalId String?
  sucursal   Sucursal? @relation(fields: [sucursalId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id])

  ventas Venta[]
  cajas  Caja[]
  pagos  PagoCliente[]
  movimientosStock MovimientoStock[]

  @@index([empresaId])
}

model Categoria {
  id          String     @id @default(cuid())
  nombre      String
  descripcion String?
  esSistema   Boolean    @default(false) // categorías del sistema (ej. "Elaborados"): no se renombran ni borran
  productos   Producto[]

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id])

  @@unique([empresaId, nombre])
  @@index([empresaId])
}

model Producto {
  id           String   @id @default(cuid())
  codigoBarras String?
  codigoInterno String?
  nombre       String
  descripcion  String?
  categoriaId  String?
  categoria    Categoria? @relation(fields: [categoriaId], references: [id])
  precioCosto  Float    @default(0)
  precioVenta  Float    @default(0)
  porcentajeVenta      Float    @default(30)
  porcentajeCrecimiento Float   @default(10)
  unidad       UnidadVenta @default(UNIDAD)
  esElaborado  Boolean  @default(false)
  margen       Float?
  iva          Float    @default(21)
  activo       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id])

  stocks        Stock[]
  detalleVentas DetalleVenta[]
  detalleCompras DetalleCompra[]
  movimientosStock MovimientoStock[]
  receta        RecetaItem[] @relation("Elaborado")
  usadoEnReceta RecetaItem[] @relation("Insumo")

  @@unique([empresaId, codigoBarras])
  @@unique([empresaId, codigoInterno])
  @@index([empresaId])
}

model Stock {
  id         String   @id @default(cuid())
  productoId String
  producto   Producto @relation(fields: [productoId], references: [id])
  sucursalId String
  sucursal   Sucursal @relation(fields: [sucursalId], references: [id])
  cantidad   Float    @default(0)
  stockMinimo Float   @default(5)
  updatedAt  DateTime @updatedAt

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id])

  @@unique([productoId, sucursalId])
  @@index([sucursalId])
  @@index([empresaId])
}

model MovimientoStock {
  id           String              @id @default(cuid())
  fecha        DateTime            @default(now())
  tipo         TipoMovimientoStock
  cantidad     Float // positivo = entra stock, negativo = sale
  stockAntes   Float
  stockDespues Float
  costoUnitario Float              @default(0) // costo del producto al momento (para valuar la merma)
  descripcion  String?

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id])

  productoId String
  producto   Producto @relation(fields: [productoId], references: [id])

  sucursalId String
  sucursal   Sucursal @relation(fields: [sucursalId], references: [id])

  usuarioId String?
  usuario   Usuario? @relation(fields: [usuarioId], references: [id])

  @@index([empresaId, sucursalId, fecha])
  @@index([empresaId, productoId, fecha])
}

model RecetaItem {
  id       String @id @default(cuid())
  cantidad Float // en la unidad base del insumo (KG -> kg, UNIDAD -> unidades)
  merma    Float @default(0) // % de merma del insumo (ej. 10 = se aprovecha el 90%)

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id])

  elaboradoId String
  elaborado   Producto @relation("Elaborado", fields: [elaboradoId], references: [id], onDelete: Cascade)

  insumoId String
  insumo   Producto @relation("Insumo", fields: [insumoId], references: [id])

  @@unique([elaboradoId, insumoId])
  @@index([elaboradoId])
  @@index([empresaId])
}

model Proveedor {
  id        String   @id @default(cuid())
  nombre    String
  cuit      String?
  telefono  String?
  email     String?
  direccion String?
  saldoCuenta Float  @default(0) // deuda a cuenta corriente con el proveedor
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id])

  compras Compra[]

  @@unique([empresaId, cuit])
  @@index([empresaId])
}

model Cliente {
  id        String   @id @default(cuid())
  nombre    String
  dni       String?
  telefono  String?
  email     String?
  direccion String?
  saldoCuenta Float @default(0) // cuenta corriente
  sucursalId String?
  sucursal   Sucursal? @relation(fields: [sucursalId], references: [id])
  createdAt DateTime @default(now())

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id])

  ventas Venta[]
  pagos   PagoCliente[]

  @@unique([empresaId, dni])
  @@index([empresaId])
}

model PagoCliente {
  id         String   @id @default(cuid())
  fecha      DateTime @default(now())
  monto      Float
  metodoPago String // EFECTIVO, TARJETA, TRANSFERENCIA
  descripcion String?

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id])

  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id])

  sucursalId String?
  sucursal   Sucursal? @relation(fields: [sucursalId], references: [id])

  usuarioId String?
  usuario   Usuario? @relation(fields: [usuarioId], references: [id])

  cajaId String?
  caja   Caja? @relation(fields: [cajaId], references: [id])

  @@index([empresaId, clienteId, fecha])
}

model Venta {
  id         String      @id @default(cuid())
  nroComprobante Int    @unique @default(autoincrement())
  fecha      DateTime    @default(now())
  total      Float
  descuento  Float       @default(0)
  estado     EstadoVenta @default(COMPLETADA)
  metodoPago String      @default("EFECTIVO") // EFECTIVO, TARJETA, TRANSFERENCIA, CUENTA_CORRIENTE

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id])

  sucursalId String
  sucursal   Sucursal @relation(fields: [sucursalId], references: [id])

  clienteId String?
  cliente   Cliente? @relation(fields: [clienteId], references: [id])

  usuarioId String?
  usuario   Usuario? @relation(fields: [usuarioId], references: [id])

  detalles DetalleVenta[]
  cajaId   String?
  caja     Caja? @relation(fields: [cajaId], references: [id])

  @@index([empresaId, sucursalId, fecha])
}

model DetalleVenta {
  id         String  @id @default(cuid())
  ventaId    String
  venta      Venta   @relation(fields: [ventaId], references: [id], onDelete: Cascade)
  productoId String
  producto   Producto @relation(fields: [productoId], references: [id])
  cantidad   Float
  precioUnitario Float
  subtotal   Float

  // Foto del precio al momento de vender (desglose: costo + %venta + %crecimiento)
  precioCosto           Float?
  porcentajeVenta       Float?
  porcentajeCrecimiento Float?
  aporteVenta           Float?
  aporteCrecimiento     Float?

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id])

  @@index([productoId])
  @@index([empresaId])
}

model Compra {
  id         String   @id @default(cuid())
  fecha      DateTime @default(now())
  total      Float
  nroFactura String?
  metodoPago String   @default("EFECTIVO") // EFECTIVO, TRANSFERENCIA, TARJETA, CUENTA_CORRIENTE
  estado     String   @default("CONFIRMADA") // BORRADOR, CONFIRMADA
  fechaConfirmacion DateTime?

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id])

  sucursalId String
  sucursal   Sucursal @relation(fields: [sucursalId], references: [id])

  proveedorId String?
  proveedor   Proveedor? @relation(fields: [proveedorId], references: [id])

  detalles DetalleCompra[]

  @@index([empresaId, sucursalId])
}

model DetalleCompra {
  id         String  @id @default(cuid())
  compraId   String
  compra     Compra  @relation(fields: [compraId], references: [id], onDelete: Cascade)
  productoId String
  producto   Producto @relation(fields: [productoId], references: [id])
  cantidad   Float
  precioCosto Float
  porcentajeVenta Float @default(30)
  porcentajeCrecimiento Float @default(10)
  subtotal   Float

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id])

  @@index([empresaId])
}

model Caja {
  id         String   @id @default(cuid())
  fechaApertura DateTime @default(now())
  fechaCierre   DateTime?
  montoInicial  Float
  montoInicialVirtual Float @default(0)
  montoFinal    Float?
  montoFinalVirtual Float?
  estado     String   @default("ABIERTA") // ABIERTA, CERRADA

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id])

  sucursalId String
  sucursal   Sucursal @relation(fields: [sucursalId], references: [id])

  usuarioId String
  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  ventas Venta[]
  pagos   PagoCliente[]
  movimientos MovimientoCaja[]

  @@index([empresaId, sucursalId, estado])
}

model MovimientoCaja {
  id        String @id @default(cuid())
  cajaId    String
  caja      Caja @relation(fields: [cajaId], references: [id], onDelete: Cascade)
  tipo      TipoMovimientoCaja
  monto     Float
  metodoPago String  @default("EFECTIVO") // EFECTIVO, TRANSFERENCIA, TARJETA
  descripcion String?
  createdAt DateTime @default(now())

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id])

  @@index([empresaId])
}